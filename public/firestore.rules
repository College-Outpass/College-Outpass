rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is principal
    function isPrincipal() {
      let email = request.auth.token.email;
      return email == 'pucneetboysprincipal@srichaitanyacollege.net' ||
             email == 'ecitypucprincipal2@srichaitanyacollege.net' ||
             email == 'ecitypucprincipal1@srichaitanyacollege.net' ||
             email == 'electroniccityprincipal@srichaitanyaschool.net' ||
             email == 'srinivasnaidu.m@srichaitanyaschool.net' ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Students collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && isPrincipal();
      allow update: if isAuthenticated() && (isPrincipal() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsappNumber', 'updatedAt']));
    }
    
    // Outpasses collection
    match /outpasses/{outpassId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isPrincipal();
    }
    
    // MediSlips collection
    match /mediSlips/{mediSlipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isPrincipal();
    }
    
    // Settings collection
    match /settings/{settingId} {
      allow read: if settingId == 'logo' || isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isPrincipal();
    }
    
    // Security collection
    match /security/{securityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Admins collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

